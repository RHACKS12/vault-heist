# Vault Heist — environment configuration
# Copy to .env and fill in. The dashboard and the MOCK race run WITHOUT any of
# these; the values below are only needed to run the REAL agent models.

# ─── API keys — STILL NEEDED to wire the real providers (Milestone 3b) ───
# Until these are set, the crew runs on mock providers (see docs/progress.md).
GEMINI_API_KEY=
OPENAI_API_KEY=           # ChatGPT crew member (gpt-4o-mini)
ANTHROPIC_API_KEY=        # Haiku — optional / swappable crew member

# ─── Announcer voices (Milestone 6b) ───
# The announcer already works on the browser's built-in speech without a key.
# To use real ElevenLabs voices, set the key + voice and run (once):
#   npm run generate:announcer   (from server/, on a machine with internet)
# That pre-generates every line to web/announcer/ so there is ZERO per-event
# cost on stage. Commit web/announcer/ afterwards.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=    # the heist-crew voice id to use
# ELEVENLABS_MODEL=       # defaults to eleven_multilingual_v2

# ─── Later milestones ───
# HOST_TOKEN=             # gate the host "lock bets & start" + record/replay controls

# ─── Server ───
# PORT=3000
# RACE_COST_CAP_USD=2      # hard per-race spend ceiling, shared across all agents; 0 disables
